generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                      @id @default(cuid())
  name                       String?
  email                      String                      @unique
  emailVerified              DateTime?
  password                   String?
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  competency                 Int?
  role                       UserType                    @default(STANDARD)
  firstName                  String?
  gender                     Gender?
  lastName                   String?
  privacyPolicyAccepted      Boolean                     @default(false)
  region                     String?
  mhpssLevel                 MhpssLevel?
  mhpssCertificateFileUrl    String?
  responderOrganization      String?
  fullAddress                String?
  accounts                   Account[]
  Authenticator              Authenticator[]
  incidents                  Incident[]
  miSaludMemberships         MiSaludMembership[]
  miSaludRequestsReviewed    MiSaludRequest[]            @relation("MiSaludRequestReviewedBy")
  miSaludRequests            MiSaludRequest[]            @relation("MiSaludRequestUser")
  miSaludTeamsLed            MiSaludTeam[]               @relation("MiSaludTeamLeader")
  roleChangeRequestsReviewed RoleChangeRequest[]         @relation("ReviewedBy")
  roleChangeRequests         RoleChangeRequest[]         @relation("RoleChangeUser")
  sessions                   Session[]
  submissions                Submission[]
  Unahon                     Unahon[]
  notifications              Notification[]
  unahonReassessmentAssigned UnahonReassessmentRequest[] @relation("UnahonReassessmentRequestedBy")
  unahonReassessmentRequests UnahonReassessmentRequest[] @relation("UnahonReassessmentUser")
}

model RoleChangeRequest {
  id                               String        @id @default(cuid())
  userId                           String
  fromRole                         UserType
  toRole                           UserType
  status                           RequestStatus @default(PENDING)
  createdAt                        DateTime      @default(now())
  reviewedAt                       DateTime?
  reviewedById                     String?
  updatedAt                        DateTime      @default(now()) @updatedAt
  requestedMhpssLevel              MhpssLevel?
  requestedMhpssCertificateFileUrl String?
  requestedResponderOrganization   String?
  reviewedBy                       User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  user                             User          @relation("RoleChangeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Incident {
  id                  String           @id @default(cuid())
  location            String
  date                DateTime
  summary             String
  description         String
  category            IncidentCategory
  reporter            String?
  contact             String?
  attachments         String[]         @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  teamDeployed        String
  otherCategoryDetail String?
  reviewNote          String?
  reviewedAt          DateTime?
  reviewedBy          String?
  status              IncidentStatus   @default(PENDING)
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([teamDeployed])
}

model Unahon {
  id             String         @id @default(cuid())
  client         String
  userId         String
  affiliation    String
  date           DateTime
  assessmentType AssessmentType
  location       String?
  checklist      Checklist[]
  responder      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([client])
  @@index([location])
  @@index([date])
}

model UnahonReassessmentRequest {
  id            String                   @id @default(cuid())
  userId        String
  requestedById String
  status        UnahonReassessmentStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  completedAt   DateTime?
  affiliation   String?
  client        String?
  requestedBy   User                     @relation("UnahonReassessmentRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  user          User                     @relation("UnahonReassessmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestedById])
  @@index([status])
}

model Checklist {
  agree    Boolean @default(false)
  disagree Boolean @default(false)
  unahonId String
  category Int
  key      Int
  Unahon   Unahon  @relation(fields: [unahonId], references: [id], onDelete: Cascade)

  @@id([category, key, unahonId])
}

model PlaceCoordinate {
  id        String @id @default(cuid())
  place     String @unique
  count     Int
  latitude  Float
  longitude Float
}

model Submission {
  id        String             @id @default(cuid())
  name      String
  date      DateTime
  team      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  userId    String
  responses QuestionResponse[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionResponse {
  id             String     @id @default(cuid())
  questionId     Int
  questionText   String
  selectedOption String
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model MiSaludTeam {
  id                String                      @id @default(cuid())
  name              String                      @unique
  leaderUserId      String
  status            RequestStatus               @default(PENDING)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reviewedAt        DateTime?
  reviewedById      String?
  memberships       MiSaludMembership[]
  requests          MiSaludRequest[]
  screeningSchedules MiSaludScreeningSchedule[]
  leader            User                        @relation("MiSaludTeamLeader", fields: [leaderUserId], references: [id], onDelete: Cascade)
}

model MiSaludMembership {
  id         String           @id @default(cuid())
  userId     String
  teamId     String
  role       MiSaludTeamRole
  status     MembershipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  approvedAt DateTime?
  team       MiSaludTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([status])
}

model MiSaludRequest {
  id              String             @id @default(cuid())
  userId          String
  fullName        String
  age             Int
  address         String
  requestedRole   MiSaludTeamRole
  teamName        String
  teamId          String?
  status          RequestStatus      @default(PENDING)
  reviewLevel     MiSaludReviewLevel
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  reviewedBy      User?              @relation("MiSaludRequestReviewedBy", fields: [reviewedById], references: [id])
  team            MiSaludTeam?       @relation(fields: [teamId], references: [id])
  user            User               @relation("MiSaludRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([reviewLevel])
}

enum IncidentStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

enum UserType {
  ADMIN
  RESPONDER
  STANDARD
}

enum Gender {
  MALE
  FEMALE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MhpssLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

enum IncidentCategory {
  SAFETY_HAZARD
  EQUIPMENT_MALFUNCTION
  SECURITY_BREACH
  NEAR_MISS
  ENVIRONMENTAL_SPILL
  OTHER
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssessmentType {
  INITIAL_ASSESSMENT
  RE_ASSESSMENT
}

enum UnahonReassessmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MiSaludTeamRole {
  TEAM_LEADER
  TEAM_MEMBER
}

enum MiSaludReviewLevel {
  ADMIN
  TEAM_LEADER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  refId     String?
  refType   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  MISALUD_REQUEST_APPROVED
  MISALUD_REQUEST_REJECTED
  MISALUD_TEAM_APPROVED
  MISALUD_TEAM_REJECTED
  MISALUD_NEW_REQUEST
  GENERAL
}

model MiSaludScreeningSchedule {
  id             String                  @id @default(cuid())
  teamId         String
  createdById    String
  screeningType  MiSaludScreeningType
  validDate      DateTime
  dueDate        DateTime
  status         ScreeningScheduleStatus @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  team           MiSaludTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
  @@index([createdAt])
}

enum MiSaludScreeningType {
  PRE_DEPLOYMENT
  DURING_DEPLOYMENT
  POST_DEPLOYMENT
}

enum ScreeningScheduleStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
